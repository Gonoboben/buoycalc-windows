<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:BuoyCalc.Windows.Services"
        xmlns:local="using:BuoyCalc.Windows.Views"
        x:Class="BuoyCalc.Windows.Views.CurrentProfileWindow"
        Width="860"
        Height="680"
        MinWidth="760"
        MinHeight="560"
        Background="#F3F6FA"
        Title="Профиль течения по глубине">

  <Window.Resources>
    <local:ProfilePointPlanarProjectionConverter x:Key="ProfileProjectionConverter" />
  </Window.Resources>

  <Grid RowDefinitions="Auto,210,8,*,Auto" Margin="18" RowSpacing="10">
    <Border Background="White" CornerRadius="16" Padding="16" BoxShadow="0 2 12 #18000000">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <TextBlock Text="Профиль течения по глубине" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="?"
                     FontSize="14"
                     FontWeight="Bold"
                     Foreground="#315B9A"
                     VerticalAlignment="Center"
                     ToolTip.Tip="Задайте U/V/W и плотность воды по глубине. Линия разбивается на сегменты не длиннее 0.20 м; U/V/W и плотность интерполируются на глубине каждого сегмента. Базовая модель сопротивления использует только |Uгор|. Компонента W применяется в ориентационно-зависимой X/Z-оценке силы линии и поэтому может влиять на кандидатную и выбранную форму, но не на базовые проверки якоря и слабого звена. Для буя, соединителей и приборов применяется max |Uгор| профиля, а для расчётов веса в воде — средняя плотность профиля." />
        </StackPanel>
        <Border Grid.Column="1" Background="#E9EFFA" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
          <TextBlock Text="{x:Static services:AppInfo.DisplayVersion}" FontSize="12" Foreground="#263653" FontWeight="Bold" />
        </Border>
      </Grid>
    </Border>

    <Border Grid.Row="1" MinHeight="130" Background="White" CornerRadius="16" Padding="14" BoxShadow="0 2 12 #18000000">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <CheckBox IsChecked="{Binding UseCurrentProfile}" Content="Использовать профиль течения вместо одного значения CurrentSpeed" />
          <TextBox Text="{Binding PlanarXAxisAzimuthDeg}" Watermark="Азимут оси +X, ° (0 = Север, 90 = Восток; пусто = не задан)" FontSize="12" />
          <Border Background="#F7F9FC" CornerRadius="10" Padding="10">
            <TextBlock Text="{Binding CurrentProfileSummary}" FontSize="12" Foreground="#697386" TextWrapping="Wrap" />
          </Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button Content="+ добавить точку профиля" Command="{Binding AddCurrentProfilePointCommand}" Padding="12,8" />
            <Button Grid.Column="1" Content="Сбросить учебный профиль" Command="{Binding ResetCurrentProfileCommand}" Padding="12,8" />
          </Grid>
        </StackPanel>
      </ScrollViewer>
    </Border>

    <GridSplitter Grid.Row="2"
                  Height="8"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Center"
                  Background="#D7DEE9" />

    <Border Grid.Row="3" MinHeight="140" Background="White" CornerRadius="16" Padding="14" BoxShadow="0 2 12 #18000000">
      <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Border Background="#E9EFFA" BorderBrush="#D7DEE9" BorderThickness="1" Padding="6">
          <Grid ColumnDefinitions="90,110,110,110,120,*,70" ColumnSpacing="8">
            <TextBlock Text="Глубина, м" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="1" Text="U East" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="2" Text="V North" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="3" Text="W Vert. (+ вниз)" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="4" Text="ρ, кг/м³" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="5" Text="Сводка" FontSize="11" FontWeight="Bold" />
            <TextBlock Grid.Column="6" Text="" FontSize="11" FontWeight="Bold" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding CurrentProfilePoints}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border BorderBrush="#D7DEE9" BorderThickness="1" CornerRadius="10" Padding="6" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="90,110,110,110,120,*,70" ColumnSpacing="8">
                    <TextBox Text="{Binding DepthM}" FontSize="12" />
                    <TextBox Grid.Column="1" Text="{Binding EastCurrentMS}" FontSize="12" />
                    <TextBox Grid.Column="2" Text="{Binding NorthCurrentMS}" FontSize="12" />
                    <TextBox Grid.Column="3" Text="{Binding VerticalCurrentMS}" FontSize="12" />
                    <TextBox Grid.Column="4" Text="{Binding WaterDensityKgM3}" FontSize="12" />
                    <StackPanel Grid.Column="5" Spacing="3" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#697386" TextWrapping="Wrap" />
                      <TextBlock FontSize="11" Foreground="#697386" TextWrapping="Wrap">
                        <TextBlock.Text>
                          <MultiBinding Converter="{StaticResource ProfileProjectionConverter}">
                            <Binding Path="EastCurrentMS" />
                            <Binding Path="NorthCurrentMS" />
                            <Binding Path="VerticalCurrentMS" />
                            <Binding Path="DataContext.PlanarXAxisAzimuthDeg" RelativeSource="{RelativeSource FindAncestor, AncestorType=Window}" />
                          </MultiBinding>
                        </TextBlock.Text>
                      </TextBlock>
                    </StackPanel>
                    <Button Grid.Column="6" Content="×" Command="{Binding RemoveCommand}" Width="42" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>

    <Border Grid.Row="4" Background="White" CornerRadius="16" Padding="14" BoxShadow="0 2 12 #18000000">
      <TextBlock Text="Закройте окно крестиком. Изменения применяются сразу и сохраняются вместе с проектом." FontSize="12" Foreground="#697386" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>